# 값은 절대 커밋하지 않는다. 로컬은 .env.local, 배포는 Vercel 환경변수에 넣는다.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 토스페이먼츠 (문서용 테스트 키)
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 결제 승인 확정용 서버 전용 비밀값. Supabase 의 shoe_app_secrets 테이블 값과 같아야 한다.
ORDER_CONFIRM_SECRET=

# AI 가상 실착 (Hugging Face Space). 없으면 AI 탭이 자동으로 비활성화된다.
HF_TOKEN=
HF_SPACE_ID=
